# ==============================================================
# AI Text Summarizer Configuration
# ==============================================================

# Choose which LLM provider to use: 'openai' or 'gemini'
PROVIDER=openai

# OpenAI Settings (Get your key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (Get your free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
